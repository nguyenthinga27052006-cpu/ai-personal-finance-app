APP_ENV=development
COMPOSE_PROJECT_NAME=finance-assistant
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

POSTGRES_DB=finance
POSTGRES_USER=finance_dev
POSTGRES_PASSWORD=finance_dev_local_only
POSTGRES_PORT=5433

REDIS_PORT=6379
# Docker context: used by the API and worker inside the Compose network.
DATABASE_URL=postgresql://finance_dev:finance_dev_local_only@postgres:5432/finance
# Host context: used by Alembic and other Windows host-side database tools.
HOST_DATABASE_URL=postgresql://finance_dev:finance_dev_local_only@localhost:5433/finance
# Host integration-test context: isolated database; replace the password placeholder locally.
POSTGRES_TEST_DATABASE_URL=postgresql://finance_dev:replace-with-local-password@localhost:5433/finance_test
# Docker context: used by the API and worker inside the Compose network.
REDIS_URL=redis://redis:6379/0

# Authentication settings. Replace JWT_SECRET outside local development.
JWT_SECRET=development-only-change-me-32-bytes-minimum
JWT_ISSUER=ai-personal-finance-api
JWT_AUDIENCE=ai-personal-finance-mobile
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_SESSION_TTL_DAYS=30
