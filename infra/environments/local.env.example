APP_ENV=development
APP_PORT=8000
POSTGRES_DB=finance
POSTGRES_USER=finance
POSTGRES_PASSWORD=replace-local-only
POSTGRES_PORT=5433
REDIS_PORT=6379
DATABASE_URL=postgresql://finance:replace-local-only@postgres:5432/finance
HOST_DATABASE_URL=postgresql://finance:replace-local-only@localhost:5433/finance
REDIS_URL=redis://redis:6379/0
JWT_SECRET=replace-with-local-secret-at-least-32-bytes
NOTIFICATION_WORKER_TOKEN=replace-local-worker-token
AI_PROVIDER=fake
AI_ENABLED=false
