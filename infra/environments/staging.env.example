# Staging-only values. Inject actual secrets from a secret manager in CI.
APP_ENV=staging
APP_IMAGE=ghcr.io/example/finance-assistant-api@sha256:REPLACE_AFTER_TRUSTED_BUILD
WORKER_IMAGE=ghcr.io/example/finance-assistant-worker@sha256:REPLACE_AFTER_TRUSTED_BUILD
DATABASE_URL=postgresql+psycopg://REPLACE_FROM_SECRET_MANAGER
HOST_DATABASE_URL=unused-in-runtime
REDIS_URL=redis://REPLACE_FROM_SECRET_MANAGER
JWT_SECRET=REPLACE_FROM_SECRET_MANAGER
NOTIFICATION_WORKER_TOKEN=REPLACE_FROM_SECRET_MANAGER
AI_PROVIDER=fake
AI_ENABLED=false
ENVIRONMENT_OWNER=platform-team
